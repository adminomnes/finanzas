generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleType {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  PAGADO
  ARCHIVADO
}

enum IncomeStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum InvoiceStatus {
  BORRADOR
  EMITIDA
  ENVIADA
  PENDIENTE_PAGO
  PAGADA
  VENCIDA
  ANULADA
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  EXPORT
  PERMISSION_CHANGE
  PASSWORD_CHANGE
  PASSWORD_RESET
  SESSION_REVOKE
  ACCOUNT_LOCK
  APPROVE
  REJECT
  SOFT_DELETE
}

enum AuditModule {
  USUARIOS
  SEGURIDAD
  FINANZAS
  CONFIGURACION
  PROVEEDORES
  AUDITORIA
  CLIENTES
  FACTURACION
  COBRANZA
  MULTIEMPRESA
  DESARROLLO
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          RoleType  @default(OPERATOR)
  isActive      Boolean   @default(true)
  mustChangePwd Boolean   @default(true)
  lastLogin     DateTime?
  isLocked      Boolean   @default(false)
  lockedUntil   DateTime?
  failedAttempts Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedExpenses    Expense[]               @relation("ExpenseResponsible")
  createdExpenses     Expense[]               @relation("ExpenseCreator")
  createdIncome       Income[]                @relation("IncomeCreator")
  auditLogs           AuditLog[]
  sessions            Session[]
  passwordResets      PasswordReset[]
  loginAttempts       LoginAttempt[]
  expenseStatusChanges ExpenseStatusHistory[]
  expenseDocuments    ExpenseDocument[]
  createdInvoices     Invoice[]               @relation("InvoiceCreator")
  registeredPayments  Payment[]               @relation("PaymentCreator")
  invoiceStatusChanges InvoiceStatusHistory[]
  companyUsers         CompanyUser[]
  developmentTasks     DevelopmentRoadmap[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  ipAddress String?
  userAgent String?
  device    String?
  isActive  Boolean  @default(true)
  lastUsed  DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId String

  @@index([token])
  @@index([email])
  @@index([expiresAt])
  @@map("password_resets")
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

model Permission {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  module    String
  description String?
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([key])
  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  role         RoleType
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model Company {
  id            String   @id @default(uuid())
  name          String
  businessName  String?
  fantasyName   String?
  rut           String   @unique
  giro          String?
  address       String?
  city          String?
  region        String?
  country       String   @default("Chile")
  phone         String?
  email         String?
  website       String?
  logo          String?
  currency      String   @default("CLP")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parentCompanyId String?
  parentCompany   Company?  @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  subsidiaries    Company[] @relation("CompanyHierarchy")

  expenses         Expense[]
  income           Income[]
  invoices         Invoice[]
  companySettings  CompanySetting[]
  companyUsers     CompanyUser[]

  @@index([rut])
  @@index([parentCompanyId])
  @@map("companies")
}

model CompanySetting {
  id        String   @id @default(uuid())
  key       String
  value     String
  type      String   @default("STRING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
  @@map("company_settings")
}

model CompanyUser {
  id        String   @id @default(uuid())
  role      String   @default("MEMBER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  userId    String
  companyId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("company_users")
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  rut       String   @unique
  address   String?
  phone     String?
  email     String?
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([rut])
  @@index([name])
  @@map("suppliers")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  type      String    @default("EXPENSE")
  color     String    @default("#6366F1")
  icon      String    @default("file-text")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses Expense[]
  income   Income[]

  @@unique([name, type])
  @@index([type])
  @@map("categories")
}

model CostCenter {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  budget    Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([code])
  @@map("cost_centers")
}

model Expense {
  id             String        @id @default(uuid())
  code           String        @unique
  date           DateTime
  documentType   String        @default("BOLETA")
  documentNumber String?
  documentDate   DateTime?
  description    String
  netAmount      Float
  taxAmount      Float         @default(0)
  totalAmount    Float
  currency       String        @default("CLP")
  paymentMethod  String        @default("TRANSFERENCIA")
  account        String?
  area           String?
  status         ExpenseStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  companyId      String
  supplierId     String
  categoryId     String
  costCenterId   String
  responsibleId  String
  createdById    String

  company       Company     @relation(fields: [companyId], references: [id])
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  category      Category    @relation(fields: [categoryId], references: [id])
  costCenter    CostCenter  @relation(fields: [costCenterId], references: [id])
  responsible   User        @relation("ExpenseResponsible", fields: [responsibleId], references: [id])
  createdBy     User        @relation("ExpenseCreator", fields: [createdById], references: [id])

  statusHistory ExpenseStatusHistory[]
  documents     ExpenseDocument[]
  attachments   Attachment[]

  @@index([code])
  @@index([date])
  @@index([status])
  @@index([companyId])
  @@index([supplierId])
  @@index([categoryId])
  @@index([costCenterId])
  @@index([responsibleId])
  @@map("expenses")
}

model ExpenseStatusHistory {
  id             String        @id @default(uuid())
  previousStatus ExpenseStatus?
  newStatus      ExpenseStatus
  comment        String?
  changedById    String
  createdAt      DateTime      @default(now())

  expenseId      String
  expense        Expense       @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  changedBy      User          @relation(fields: [changedById], references: [id])

  @@index([expenseId])
  @@index([createdAt])
  @@map("expense_status_history")
}

model ExpenseDocument {
  id          String   @id @default(uuid())
  fileName    String
  fileSize    Int
  mimeType    String
  url         String
  key         String
  uploadedAt  DateTime @default(now())
  uploadedById String

  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  uploadedBy  User     @relation(fields: [uploadedById], references: [id])

  @@index([expenseId])
  @@map("expense_documents")
}

model Income {
  id            String       @id @default(uuid())
  date          DateTime
  description   String
  netAmount     Float
  taxAmount     Float        @default(0)
  totalAmount   Float
  paymentMethod String       @default("TRANSFERENCIA")
  status        IncomeStatus @default(RECEIVED)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  companyId     String
  categoryId    String
  createdById   String

  company       Company  @relation(fields: [companyId], references: [id])
  category      Category @relation(fields: [categoryId], references: [id])
  createdBy     User     @relation("IncomeCreator", fields: [createdById], references: [id])

  attachments   Attachment[]

  @@index([date])
  @@index([status])
  @@index([companyId])
  @@index([categoryId])
  @@map("income")
}

model Client {
  id              String    @id @default(uuid())
  name            String
  rut             String    @unique
  type            String    @default("EMPRESA")
  address         String?
  phone           String?
  email           String?
  contactName     String?
  paymentTerms    String    @default("30")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoices        Invoice[]

  @@index([rut])
  @@index([name])
  @@index([email])
  @@map("clients")
}

model Invoice {
  id              String        @id @default(uuid())
  number          String        @unique
  issueDate       DateTime
  dueDate         DateTime?
  status          InvoiceStatus @default(BORRADOR)
  description     String?
  netAmount       Float
  taxAmount       Float         @default(0)
  totalAmount     Float
  currency        String        @default("CLP")
  notes           String?
  pdfUrl          String?
  xmlUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  clientId        String
  companyId       String
  createdById     String

  client          Client        @relation(fields: [clientId], references: [id])
  company         Company       @relation(fields: [companyId], references: [id])
  createdBy       User          @relation("InvoiceCreator", fields: [createdById], references: [id])

  items           InvoiceItem[]
  payments        Payment[]
  statusHistory   InvoiceStatusHistory[]

  @@index([number])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([clientId])
  @@index([companyId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  description String
  quantity    Float    @default(1)
  unitValue   Float
  discount    Float    @default(0)
  total       Float
  createdAt   DateTime @default(now())

  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id            String   @id @default(uuid())
  date          DateTime
  amount        Float
  method        String   @default("TRANSFERENCIA")
  bank          String?
  account       String?
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())

  invoiceId     String
  createdById   String

  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  createdBy     User     @relation("PaymentCreator", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([date])
  @@map("payments")
}

model InvoiceStatusHistory {
  id             String        @id @default(uuid())
  previousStatus InvoiceStatus?
  newStatus      InvoiceStatus
  comment        String?
  createdAt      DateTime      @default(now())

  invoiceId      String
  changedById    String

  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedBy      User          @relation(fields: [changedById], references: [id])

  @@index([invoiceId])
  @@index([createdAt])
  @@map("invoice_status_history")
}

model Attachment {
  id          String   @id @default(uuid())
  fileName    String
  fileSize    Int
  mimeType    String
  url         String
  key         String
  uploadedAt  DateTime @default(now())

  expenseId   String?
  incomeId    String?

  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  income      Income?  @relation(fields: [incomeId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([incomeId])
  @@map("attachments")
}

model AuditLog {
  id            String       @id @default(uuid())
  action        AuditAction
  module        AuditModule?
  entity        String
  entityId      String?
  description   String
  oldValue      Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  browser       String?
  os            String?
  device        String?
  role          String?
  createdAt     DateTime     @default(now())

  userId        String

  user          User         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   @default("STRING")
  group       String   @default("GENERAL")
  isEncrypted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([group])
  @@map("settings")
}

enum DevPriority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum DevStatus {
  PENDIENTE
  EN_DESARROLLO
  EN_PRUEBAS
  FINALIZADO
  CANCELADO
}

enum VersionType {
  BETA
  RC
  PRODUCCION
}

model DevelopmentVersion {
  id           String      @id @default(uuid())
  version      String      @unique // e.g. "v1.0.0"
  type         VersionType @default(PRODUCCION)
  releaseDate  DateTime?
  description  String?
  isCurrent    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  roadmapItems DevelopmentRoadmap[]
  changelogs   DevelopmentChangelog[]

  @@map("development_versions")
}

model DevelopmentRoadmap {
  id              String      @id @default(uuid())
  name            String
  description     String?
  priority        DevPriority @default(MEDIA)
  status          DevStatus   @default(PENDIENTE)
  estimatedDate   DateTime?
  notes           String?
  orderIndex      Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  versionId       String?
  assigneeId      String?

  version         DevelopmentVersion? @relation(fields: [versionId], references: [id])
  assignee        User?               @relation(fields: [assigneeId], references: [id])

  @@index([versionId])
  @@index([assigneeId])
  @@map("development_roadmap")
}

model DevelopmentChangelog {
  id               String   @id @default(uuid())
  releaseDate      DateTime
  description      String?
  features         String?
  fixes            String?
  securityChanges  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versionId        String
  version          DevelopmentVersion @relation(fields: [versionId], references: [id])

  @@index([versionId])
  @@map("development_changelog")
}

model DevelopmentBacklog {
  id          String      @id @default(uuid())
  title       String
  description String?
  priority    DevPriority @default(MEDIA)
  status      String      @default("IDEA")
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("development_backlog")
}
